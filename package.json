{
  "name": "orion",
  "version": "0.3.6",
  "description": "ORION (Operational Reasoning & Intelligence Orchestration Network) by Aethera Healthcare Solutions — self-hosted AI for US healthcare Revenue Cycle Management and medical billing & coding",
  "license": "MIT",
  "type": "module",
  "bin": {
    "orion": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "dev": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "deploy": "wrangler deploy",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.0",
    "@google/genai": "^2.16.0",
    "commander": "^15.0.0",
    "fastify": "^5.0.0",
    "imapflow": "^1.6.6",
    "json5": "^2.2.3",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "openai": "^7.4.0",
    "playwright": "^1.62.1",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.120.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.0",
    "tesseract.js": "^7.0.0"
  }
}
