{
  // Deployment of Orion to aetheraonline.com.
  //
  // Read this next to worker/index.ts and Dockerfile — the three describe one
  // arrangement: a Worker that verifies Cloudflare Access and pins each tenant
  // to one container instance, a container running the Node gateway, and an R2
  // bucket holding the database snapshot that makes an ephemeral disk survivable.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orion",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],

  // The hostname itself. With PUBLIC_ACCESS off, Access must be configured over
  // this same host in Zero Trust — the Worker refuses any request arriving
  // without an Access session, so a missing Access application fails closed
  // rather than publishing the app. With PUBLIC_ACCESS on (see vars, below),
  // that refusal is deliberately lifted and this hostname is open to anyone.
  "routes": [
    {
      "pattern": "orion.aetheraonline.com",
      "custom_domain": true
    }
  ],

  "containers": [
    {
      "class_name": "OrionContainer",
      "image": "./Dockerfile",
      // standard-1: the gateway loads ~31 MB of reference datasets, keeps a
      // SQLite working set, and shells out to pdftoppm for OCR. The lite class
      // runs out of memory on a batch of scanned EOBs.
      "instance_type": "standard-1",
      "max_instances": 20
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ORION",
        "class_name": "OrionContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OrionContainer"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "orion-snapshots"
    }
  ],

  "vars": {
    // Not secrets. The AUD is an identifier, not a credential — but it must be
    // right, or a token minted for another Access application would verify.
    //
    // Kept even while PUBLIC_ACCESS is "1": if a token IS presented it is still
    // verified against these, and putting Access back is then a one-character
    // edit below rather than a re-derivation of values nobody remembers.
    "ACCESS_TEAM_DOMAIN": "aetherahealthcare.cloudflareaccess.com",
    "ACCESS_AUD": "7a589f3f4b5a86659e027264314e93f637b41e07ca7613a9ef50a07fc49a423f",

    // ── THIS HOSTNAME IS PUBLIC ──────────────────────────────────────────────
    // "1" means no sign-in: the Worker serves an anonymous request and the
    // origin serves it too (ORION_PUBLIC, forwarded by worker/index.ts). Anyone
    // who learns the hostname gets the console, the claims database, the shell
    // and filesystem tools, and the payer-portal browser.
    //
    // Set at the owner's explicit instruction for a trial and a presentation,
    // over a raised objection, and it is written here rather than achieved by
    // deleting the check so that what the deployment does is legible in a diff.
    //
    // The demo data is synthetic (ORION_SEED_DEMO in the Dockerfile) and the
    // PHI posture is `blocked` pending the BAA, so a real chart cannot be
    // ingested while this stands. Those two facts are what make this survivable;
    // change either and this line must be reconsidered on the same day.
    //
    // TO CLOSE IT: set this to "0", deploy, and re-create the Access
    // application (workflow: access-setup.yml). Both halves, or the state on
    // Cloudflare will not match this file.
    "PUBLIC_ACCESS": "1"

    // PURGE_EMPTY_SESSIONS is deliberately NOT set here.
    //
    // It is a token naming a one-shot cleanup of empty session rows: set it,
    // and the first container boot that sees a new value purges shells with no
    // messages, records the token, and never repeats. Deliberately unset,
    // because the rows it was written for turned out to be disappearing on
    // their own — see the snapshot note in scripts/container-boot.mjs. Arming a
    // deletion while writes may already be failing to persist would destroy the
    // evidence of the more serious problem.
  },

  // GATEWAY_TOKEN is deliberately absent from this file. It is set with
  // `wrangler secret put GATEWAY_TOKEN` and stored encrypted; the same value
  // goes to the container as ORION_GATEWAY_TOKEN. A secret committed to
  // a repository is a secret published to everyone who ever clones it.
  "observability": {
    "enabled": true
  }
}
