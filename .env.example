# AetheraClaw — provider API keys (set at least one; provider chosen in config.json5)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=          # only for Ollama Cloud; local Ollama needs no key

# Optional integrations
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Mailbox credentials for the email channel. Hosts, ports and usernames live in
# config.json5 under `email`; only the passwords come from the environment, and
# they are never rendered into a prompt or a tool result.
AETHERACLAW_IMAP_PASSWORD=
AETHERACLAW_SMTP_PASSWORD=   # falls back to AETHERACLAW_IMAP_PASSWORD when unset
